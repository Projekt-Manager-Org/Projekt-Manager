# Claude Code (user-specific settings and skills)
.claude/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Build output
dist/
.vite/

# Test output
coverage/
test-results/
playwright-report/
.playwright-mcp/
# Demo master encode — large generated binary, staged here for Vimeo
# upload. The film lives on Vimeo; only the hero loop (assets/) is committed.
demo-clips/
# Playwright shared auth state — generated per-run, contains a live
# session cookie, must never be committed.
e2e/.auth/

# WIP scratch directory (local only)
docs/wip/

# Server-side runtime data (dev-generated VAPID key, etc.) — never committed.
data/

# Scratch screenshots (Playwright MCP saves to repo root by default).
# Repo-root only — keeps any deliberate `assets/*.png` etc. unaffected.
/*.png
/*.jpg
/*.jpeg

# Pixabay stock photos used only by the opt-in demo recording flow
# (`npm run demo`). Free to use and modify, but redistributing them
# standalone — as raw files in a public repo — is a Prohibited Use under
# the Pixabay Content License. Kept local-only; the committed
# assets/demo-hero.webp is a derivative (composited loop), not standalone
# Content. See docs/testing/demo-recordings.md.
e2e/fixtures/demo/*.jpg
scripts/demo/assets/phone-backdrop.jpg
